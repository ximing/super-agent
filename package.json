{
  "name": "personal-super-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "build:server": "pnpm --filter @super-agent/control-server... build",
    "db:migrate": "pnpm --filter @super-agent/control-server migrate",
    "dev:node": "pnpm --filter @super-agent/node dev",
    "dev:android": "pnpm --filter @super-agent/android start"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
