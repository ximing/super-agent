# Deploy server configuration only on cloud infrastructure.
# Never put Codex/Grok credentials here.
DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@CLOUD_POSTGRES_HOST:5432/super_agent?sslmode=verify-full
TEST_DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@CLOUD_POSTGRES_HOST:5432/super_agent_test?sslmode=verify-full
# Use migration owners only for the short-lived migration process, never API requests.
MIGRATION_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
PORT=8787
HOST=127.0.0.1
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Production always uses the user's cloud OIDC provider.
ALLOW_DEV_AUTH=false
OIDC_ISSUER=https://super-agent-auth.aimo.plus/realms/super-agent-test
OIDC_AUDIENCE=super-agent-api
OIDC_CLIENT_ID=super-agent-native
OIDC_REDIRECT_URI=superagent://oauth/callback
MEMORY_ENCRYPTION_KEY=replace-with-an-independent-random-key-and-keep-it-stable
RECALL_ALLOWED_ORIGINS=https://recall.aimo.plus
# Optional native push. Keep the APNs .p8 outside source control; in cloud
# compose put it in ./certs and use /app/certs/<filename> here.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_ENVIRONMENT=production
APNS_PRIVATE_KEY_FILE=
EXPO_PROJECT_ID=
EXPO_ACCESS_TOKEN=
S3_ENDPOINT=https://s3.aimo.plus
S3_REGION=cn-beijing
S3_BUCKET=super-agent-test
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ARTIFACT_DIR=.super-agent/artifacts
SERVER_IMAGE=YOUR_CLOUD_REGISTRY/super-agent:YOUR_RELEASE_TAG
COMPOSE_PROJECT_NAME=super-agent-test
API_PORT=13011
