[Unit]
Description=Super Agent encrypted origin tunnel
After=network-online.target
Wants=network-online.target

[Service]
User=super-agent-tunnel
Group=super-agent-tunnel
# Install as /etc/systemd/system/super-agent-origin-tunnel.service
# Destination is the SSH alias super-agent-origin. Its address lives in the
# entry host's ssh config, not in this unit. See origin-ssh-config.example.
ExecStart=/usr/bin/ssh -NT -p 11022 -i /var/lib/super-agent-tunnel/id_ed25519 -o IdentitiesOnly=yes -o UserKnownHostsFile=/var/lib/super-agent-tunnel/known_hosts -o StrictHostKeyChecking=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -L 192.168.0.1:13010:127.0.0.1:13010 -L 192.168.0.1:13011:127.0.0.1:13011 -R 127.0.0.1:3128:127.0.0.1:3128 super-agent-proxy@super-agent-origin
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
