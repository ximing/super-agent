{
  "name": "@super-agent/control-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "start": "node dist/start.js",
    "build": "tsc -p tsconfig.json",
