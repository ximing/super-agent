{
  "expo": {
    "name": "助理工作台",
    "slug": "personal-super-agent",
    "scheme": "superagent",
    "version": "0.2.0",
    "orientation": "default",
    "icon": "../../assets/branding/android/icon-store.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.superagent.control",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "../../assets/branding/android/foreground-light.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "../../assets/branding/android/monochrome.png"
      },
      "permissions": ["INTERNET", "POST_NOTIFICATIONS"]
    },
    "plugins": ["expo-secure-store", "expo-web-browser", "expo-notifications", "./plugins/with-wrapper-integrity", "./plugins/with-launcher-icons"],
    "extra": { "eas": { "projectId": "" } }
  }
}
